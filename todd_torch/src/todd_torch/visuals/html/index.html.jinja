<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    {% for css_file in css_files %}
      <link rel="stylesheet" href="{{ css_file }}">
    {% endfor %}
    {% for javascript_file in javascript_files %}
      <script defer src="{{ javascript_file }}"></script>
    {% endfor %}
  </head>
  <body>
    <div class="todd-canvas">
      {% for element in elements %}
        {{ element }}
      {% endfor %}
    </div>
  </body>
</html>
