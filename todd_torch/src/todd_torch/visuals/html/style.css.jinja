html, body {
  margin: 0;
  width: {{ width }}px;
  height: {{ height }}px;
}

@page {
  size: {{ width }}px {{ height }}px;
  margin: 0;
}

.todd-canvas {
  position: relative;
  width: {{ width }}px;
  height: {{ height }}px;
  overflow: hidden;
  background: white;
  print-color-adjust: exact;
  -webkit-print-color-adjust: exact;
}

.todd-element {
  position: absolute;
  box-sizing: border-box;
}

.todd-point {
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.todd-line {
  transform-origin: 0 50%;
}

.todd-fill {
  inset: 0;
}

.todd-text {
  overflow: hidden;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
  font-family: sans-serif;
  line-height: 1.2;
}

.todd-image {
  display: block;
}

.todd-latex .katex-display {
  margin: 0;
}

.todd-table table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  font-family: sans-serif;
  line-height: 1.2;
}

.todd-table th, .todd-table td {
  border: 1px solid currentColor;
  padding: 0.25em;
  text-align: left;
  vertical-align: top;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
