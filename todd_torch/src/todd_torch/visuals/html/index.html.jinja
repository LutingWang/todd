<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <link rel="stylesheet" href="assets/katex/katex.min.css">
    {% for asset_path in assets_root.glob('*.css') | sort %}
      <link rel="stylesheet" href="assets/{{ asset_path.name | e }}">
    {% endfor %}
    <script defer src="assets/katex/katex.min.js"></script>
    <script defer src="assets/katex/contrib/auto-render.min.js"></script>
    {% for asset_path in assets_root.glob('*.js') | sort %}
      <script defer src="assets/{{ asset_path.name | e }}"></script>
    {% endfor %}
  </head>
  <body>
    <div class="todd-canvas">
      {% for element in elements %}
        {{ element }}
      {% endfor %}
    </div>
  </body>
</html>
